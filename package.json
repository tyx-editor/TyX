{
  "name": "tyx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "bun run prebuild",
    "dev": "vite",
    "dev:app": "bun run predev && tauri dev",
    "prebuild": "wasm-pack build crates/tyx-converters-wasm --target web --out-dir ../../src/converters",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prettier": "prettier",
    "build-web": "echo 'export * from \"./web\"' > src/backend/index.ts && bun run build && echo 'export * from \"./tauri\"' > src/backend/index.ts",
    "deploy": "bun run build-web && netlify deploy -d dist --prod --no-build",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
    "schema": "bun scripts/create-json-schemas.ts && prettier -w schemas",
    "test": "wdio run wdio.conf.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lexical/code": "^0.51.0",
    "@lexical/code-prism": "^0.51.0",
    "@lexical/react": "^0.51.0",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@tabler/icons-react": "^3.47.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "i18next": "^26.4.2",
    "lexical": "^0.51.0",
    "mathlive": "^0.110.0",
    "mousetrap": "^1.6.5",
    "mousetrap-global-bind": "^1.1.0",
    "mousetrap-record": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-i18next": "^17.0.14",
    "tex2typst": "^0.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/mousetrap": "^1.6.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.0",
    "netlify-cli": "^27.8.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.1",
    "wasm-pack": "^0.15.0"
  },
  "prettier": {
    "semi": false
  }
}
